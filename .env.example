# ImmoScout24 REST API (OAuth 1.0a)
# Antrag / Keys: https://api.immobilienscout24.de
# Zwei-Bein-OAuth (nur Consumer Key/Secret) reicht fuer die Suche.
IS24_CLIENT_KEY=
IS24_CLIENT_SECRET=

# Optional: Drei-Bein-OAuth (nur noetig fuer /user/me-Endpunkte)
IS24_TOKEN=
IS24_TOKEN_SECRET=

# sandbox | live
IS24_ENV=live

# Server
PORT=3000
